

%main.main
  / Page Title
  .page-title{"data-aos" => "fade"}
    .heading
      .container
        .row.d-flex.justify-content-center.text-center
          .col-lg-8
            %h1 Starter Page
            %p.mb-0 Odio et unde deleniti. Deserunt numquam exercitationem. Officiis quo odio sint voluptas consequatur ut a odio voluptatem. Sit dolorum debitis veritatis natus dolores. Quasi ratione sint. Sit quaerat ipsum dolorem.
            %a.cta-btn{:href => home_contact_path}
              Available for Hire
              %br/
    %nav.breadcrumbs
      .container
        %ol
          %li
            = link_to "Home", root_path
          %li.current Starter Page
  / End Page Title
  / Starter Section Section
  %section#starter-section.starter-section.section
    / Section Title
    .container.section-title{"data-aos" => "fade-up"}
      %h2 Starter Section
      %p Necessitatibus eius consequatur
    / End Section Title
    .container{"data-aos" => "fade-up"}
      %p Use this page as a starter for your own custom pages.

      / Start Coding Button Section
      .row.justify-content-center.mt-4.mb-5
        .col-md-8.text-center
          .start-coding-container
            %a.start-coding-btn.start-coding-btn--pulse{:href => new_post_path}
              %i.btn-icon.bi.bi-code-slash
              Start Coding
            .btn-subtitle Create your first post and begin your coding journey!

      / Card with inner glow demo
      .row.justify-content-center.mt-5
        .col-md-6.text-center
          .card-inner-glow
            Glowing Card
            %br
            Effect Demo

      / Neon sign demo
      .row.justify-content-center.mt-5
        .col-md-8.text-center
          .neon-sign Flicker

      / Spiral demo
      .row.justify-content-center.mt-5
        .col-md-10.text-center
          .spiral-container
            .logarithmic
              - 100.times do
                .arm
  / Yoda demo
  .row.justify-content-center.mt-5
    .col-md-6.text-center
      %article{"role" => "img", "aria-label" => "cartoon of yoda in kawaii style"}
        .body
          .cloak
            .stick
            .shoulder.left
            .shoulder.right
            .arm.left
            .arm.right
        .head
          .ear.left
          .ear.right
          .face
            .cheek.left
            .cheek.right
            .eye.left
            .eye.right
            .nose
            .mouth

  / Tubes Cursor demo
  .row.justify-content-center.mt-5
    .col-md-12
      .tubes-cursor-container#tubes-demo
        %canvas#tubes-canvas
        .tubes-content
          %h3 Interactive Tubes
          %p Experience this WebGL-powered interactive background effect. Move your cursor around and click to change colors!
          .tubes-instructions Click anywhere or press Space to randomize colors





  / Snow Effect demo
  .row.justify-content-center.mt-5
    .col-md-12
      .snow-effect-container#snow-demo
        .snow-container#snow-container
          %i.snow-container__item{style: "left: 10%; animation-delay: 0s; --offset: 1;"}
          %i.snow-container__item{style: "left: 30%; animation-delay: 2s; --offset: 1.2;"}
          %i.snow-container__item{style: "left: 50%; animation-delay: 4s; --offset: 0.8;"}
          %i.snow-container__item{style: "left: 70%; animation-delay: 6s; --offset: 1.5;"}
          %i.snow-container__item{style: "left: 90%; animation-delay: 8s; --offset: 1.1;"}
        .snow-man
          .snow-man__head
            .snow-man__eye
            .snow-man__eye
            .snow-man__nose
          .snow-man__body
        .snow-content
          %h3 Winter Wonderland
          %p Beautiful animated snowfall effect with a cheerful snowman. Watch the snowflakes gently fall from the sky!
          .snow-instructions Click to add more snowflakes



  / Swirl Effect demo
  .row.justify-content-center.mt-5
    .col-md-12
      .swirl-effect-container#swirl-demo
        .swirl#swirl-container
        .swirl-content
          %h3 Hypnotic Swirl
          %p Mesmerizing animated pattern inspired by mathematical beauty. Watch the colorful dots dance in perfect harmony!
          .swirl-instructions Click to restart animation

  / Start Coding Button Variations Demo
  .row.justify-content-center.mt-5
    .col-md-12
      .container.text-center
        %h3.mb-4 Start Coding Button Variations
        %p.mb-5 Different styles inspired by CodePen's modern button effects

        / Default gradient button
        .row.justify-content-center.mb-4
          .col-md-4.mb-3
            .start-coding-container
              %a.start-coding-btn{:href => new_post_path}
                %i.btn-icon.bi.bi-code-slash
                Default Style
              .btn-subtitle Gradient with hover effects

        / Neon style button
        .row.justify-content-center.mb-4
          .col-md-4.mb-3
            .start-coding-container
              %a.start-coding-btn.start-coding-btn--neon{:href => new_post_path}
                %i.btn-icon.bi.bi-lightning
                Neon Style
              .btn-subtitle Cyberpunk inspired glow

        / Glass morphism button
        .row.justify-content-center.mb-4
          .col-md-4.mb-3
            .start-coding-container
              %a.start-coding-btn.start-coding-btn--glass{:href => new_post_path}
                %i.btn-icon.bi.bi-gem
                Glass Style
              .btn-subtitle Modern glassmorphism effect

        / Rainbow border button
        .row.justify-content-center.mb-4
          .col-md-4.mb-3
            .start-coding-container
              %a.start-coding-btn.start-coding-btn--rainbow{:href => new_post_path}
                %i.btn-icon.bi.bi-palette
                Rainbow Border
              .btn-subtitle Animated colorful border effect

        / CodePen style buttons
        .row.justify-content-center.mb-4
          .col-md-6.mb-3
            .start-coding-container
              %a.start-coding-btn.start-coding-btn--codepen-hover-only{:href => new_post_path}
                %span
                  %i.btn-icon.bi.bi-mouse
                  Hover Only
              .btn-subtitle Animates only on hover (original)
          .col-md-6.mb-3
            .start-coding-container
              %a.start-coding-btn.start-coding-btn--static-rainbow{:href => new_post_path}
                %span
                  %i.btn-icon.bi.bi-palette-fill
                  Static Rainbow
              .btn-subtitle Always visible rainbow border

