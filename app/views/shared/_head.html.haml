-# Meta tags and basic setup
= render 'shared/meta_tags'

-# Application stylesheets
= stylesheet_link_tag 'home_slider'
= stylesheet_link_tag "application", "data-turbo-track": "reload"
= stylesheet_link_tag "main", media: "all", "data-turbo-track": "reload"

-# External stylesheets
= render 'shared/external_stylesheets'

-# External scripts
= render 'shared/external_scripts'

-# Application JavaScript
= javascript_importmap_tags

-# Favicons
= render 'shared/favicons'

-# Fonts
= render 'shared/fonts'

-# Stimulus controllers for functionality
%div{"data-controller" => "time-updates aos"}
%div{"data-controller" => "locale-switcher"}
%div{"data-controller" => "avatar-preview"}